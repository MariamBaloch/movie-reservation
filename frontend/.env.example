# Same-origin proxies avoid requiring backend CORS changes.
VITE_AUTH_API_URL=/auth-api
VITE_MOVIE_API_URL=/movie-api
VITE_BOOKING_API_URL=/booking-api
AUTH_PROXY_TARGET=http://localhost:8081
MOVIE_PROXY_TARGET=http://localhost:8082
BOOKING_PROXY_TARGET=http://localhost:8083
# With backend CORS configured, use direct URLs instead:
# VITE_AUTH_API_URL=http://localhost:8081
# VITE_MOVIE_API_URL=http://localhost:8082
# VITE_BOOKING_API_URL=http://localhost:8083
